# Kopieren nach .env (cp .env.example .env) und anpassen.

# Welches LLM antwortet: auto | ollama | claude | extractive
#   auto = Claude wenn ANTHROPIC_API_KEY gesetzt, sonst Ollama wenn erreichbar, sonst extraktiv
RAG_LLM_BACKEND=ollama

# --- Lokales LLM über Ollama ---
# Name genau so wie in `ollama list` angezeigt
RAG_OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# --- Claude über die Anthropic API (optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
# RAG_LLM_MODEL=claude-sonnet-5-5

# Antwort reproduzierbar machen (0 = immer gleiche Antwort)
RAG_TEMPERATURE=0
RAG_SEED=42

# --- Suche ---
# auto | tfidf | st   (st = sentence-transformers, lädt beim ersten Mal ein Modell herunter)
RAG_EMBEDDER=auto
RAG_EMBED_MODEL=intfloat/multilingual-e5-small
RAG_DATA_DIR=data/raw
RAG_INDEX_DIR=index
